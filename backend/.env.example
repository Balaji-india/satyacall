# Copy this file to backend/.env and put the real key there. .env is git-ignored.
DETECTIF_API_KEY=put-the-key-here
DETECTIF_BASE_URL=https://platform.detectif.ai

# v3 credit rules
# DEV_REPLAY: same clip bytes -> same Idempotency-Key -> stored result, 0 credits. Set false for the demo.
DEV_REPLAY=true
# EIDOS_ON_FIRST_CLIP: Eidos on the first timeline clip (~520 credits). Only if we get more credits.
EIDOS_ON_FIRST_CLIP=false
# CREDIT_FLOOR: refuse Eidos calls below this balance
CREDIT_FLOOR=600

CLIP_SECONDS=10
