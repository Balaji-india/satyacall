# Backend (Person A's laptop). Replace localhost with A's LAN IP, e.g. http://192.168.1.20:8000
# No secrets here, ever: the DetectifAI API key lives only in backend/.env
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# PeerJS signalling server. Leave empty = free PeerJS cloud (0.peerjs.com).
# If the cloud is blocked: run `npx peer --port 9000` on one laptop and put its LAN IP here.
VITE_PEER_HOST=
VITE_PEER_PORT=

# Bank's official phone number for the /app "call your bank" button (tel: link).
# Leave empty = the app says "Use the number on the back of your card" (we never invent a number).
VITE_BANK_OFFICIAL_NUMBER=

# true = direct LAN only (no STUN/TURN, never an internet relay); both devices on the same network.
# Empty/false = PeerJS default ICE servers (may relay over the internet if direct fails).
VITE_PEER_LAN_ONLY=
