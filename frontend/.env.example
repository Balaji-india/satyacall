# Backend (Person A's laptop). Replace localhost with A's LAN IP, e.g. http://192.168.1.20:8000
# No secrets here, ever: the DetectifAI API key lives only in backend/.env
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# PeerJS signalling server. Leave empty = free PeerJS cloud (0.peerjs.com).
# If the cloud is blocked: run `npx peer --port 9000` on one laptop and put its LAN IP here.
VITE_PEER_HOST=
VITE_PEER_PORT=
